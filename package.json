{
  "name": "ai-skill-cli",
  "version": "1.0.0",
  "description": "Local AI Skill Registry CLI — quản lý kho kỹ năng cho AI agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai-skills": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --out-dir dist --clean --banner.js \"#!/usr/bin/env node\"",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "keywords": ["ai", "skills", "cli", "agent"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.0.0",
    "tsdown": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
