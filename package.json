{
  "name": "ai-skill-cli",
  "version": "1.3.0",
  "description": "Local AI Skill Registry CLI — quản lý kho kỹ năng cho AI agent",
  "homepage": "https://github.com/your-org/ai-skill-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ai-skill-cli.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ai-skill-cli/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ai-skills": "./dist/index.js",
    "ai-skills-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "keywords": [
    "ai",
    "skills",
    "cli",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xenova/transformers": "^2.17.2",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
